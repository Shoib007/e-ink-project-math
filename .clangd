CompileFlags:
  BuiltinHeaders: QueryDriver
Diagnostics:
  Suppress: [pp_expects_filename, unused-includes]
---
If:
  PathMatch: .*\.ino
CompileFlags:
  Remove: [-mlongcalls, -free, -mtext-section-literals, -fipa-pta, -fno-shrink-wrap]
  Add:
    - "-x"
    - "c++"
    - "-include"
    - "Arduino.h"
